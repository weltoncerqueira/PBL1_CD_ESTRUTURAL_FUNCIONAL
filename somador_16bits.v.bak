// adder_16bits.v
// Função: Soma dois números de 16 bits

module somador_16bits (
    input  wire [15:0] a,      // Primeiro número (16 bits)
    input  wire [15:0] b,      // Segundo número (16 bits)
    input  wire        cin,    // Carry de entrada (geralmente 0)
    output wire [15:0] sum,   // Resultado da soma (16 bits)
    output wire        cout    // Carry de saída (overflow)
);
    // Fios internos para propagar o carry
    wire [15:0] carry;
    
    // Instancia 16 full adders em cascata
    full_adder fa0 (.A(a[0]), .B(b[0]), .cin(cin),       .cout(carry[0]), .sum(sum[0]));
    full_adder fa1 (.A(a[1]), .B(b[1]), .cin(carry[0]),  .cout(carry[1]), .sum(sum[1]));
    full_adder fa2 (.A(a[2]), .B(b[2]), .cin(carry[1]),  .cout(carry[2]), .sum(sum[2]));
    full_adder fa3 (.A(a[3]), .B(b[3]), .cin(carry[2]),  .cout(carry[3]), .sum(sum[3]));
    full_adder fa4 (.A(a[4]), .B(b[4]), .cin(carry[3]),  .cout(carry[4]), .sum(sum[4]));
    full_adder fa5 (.A(a[5]), .B(b[5]), .cin(carry[4]),  .cout(carry[5]), .sum(sum[5]));
    full_adder fa6 (.A(a[6]), .B(b[6]), .cin(carry[5]),  .cout(carry[6]), .sum(sum[6]));
    full_adder fa7 (.A(a[7]), .B(b[7]), .cin(carry[6]),  .cout(carry[7]), .sum(sum[7]));
    full_adder fa8 (.A(a[8]), .B(b[8]), .cin(carry[7]),  .cout(carry[8]), .sum(sum[8]));
    full_adder fa9 (.A(a[9]), .B(b[9]), .cin(carry[8]),  .cout(carry[9]), .sum(sum[9]));
    full_adder fa10(.A(a[10]), .B(b[10]), .cin(carry[9]), .cout(carry[10]), .sum(sum[10]));
    full_adder fa11(.A(a[11]), .B(b[11]), .cin(carry[10]), .cout(carry[11]), .sum(sum[11]));
    full_adder fa12(.A(a[12]), .B(b[12]), .cin(carry[11]), .cout(carry[12]), .sum(sum[12]));
    full_adder fa13(.A(a[13]), .B(b[13]), .cin(carry[12]), .cout(carry[13]), .sum(sum[13]));
    full_adder fa14(.A(a[14]), .B(b[14]), .cin(carry[13]), .cout(carry[14]), .sum(sum[14]));
    full_adder fa15(.A(a[15]), .B(b[15]), .cin(carry[14]), .cout(carry[15]), .sum(sum[15]));
    
    // Carry de saída
    assign cout = carry[15];
endmodule