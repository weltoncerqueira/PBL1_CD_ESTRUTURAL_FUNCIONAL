// Decodificador Binário (4 bits) para Hexadecimal (7 segmentos) - ANODO COMUM
// Saída: 0 = Aceso, 1 = Apagado
// Ordem dos segmentos: {a, b, c, d, e, f, g}

module bin_to_hex_7seg (
    input  wire [3:0] bin,
    output wire [6:0] seg
);

    wire n0, n1, n2, n3;
    assign n0 = ~bin[0];
    assign n1 = ~bin[1];
    assign n2 = ~bin[2];
    assign n3 = ~bin[3];

    // Segmento A (apagado para 1, 4, b, d)
    assign seg[6] = ~( (n3 & n2 & n1 & bin[0]) |
                       (n3 & bin[2] & n1 & n0) |
                       (bin[3] & n2 & bin[1] & bin[0]) |
                       (bin[3] & bin[2] & n1 & bin[0]) );

    // Segmento B (apagado para 5, 6, b, C, E, F)
    assign seg[5] = ~( (n3 & bin[2] & bin[1] & n0) |
                       (n3 & bin[2] & bin[1] & bin[0]) |
                       (bin[3] & n2 & bin[1] & bin[0]) |
                       (bin[3] & bin[2] & n1 & n0) |
                       (bin[3] & bin[2] & bin[1] & n0) |
                       (bin[3] & bin[2] & bin[1] & bin[0]) );

    // Segmento C (apagado para 2, C, E, F)
    assign seg[4] = ~( (n3 & n2 & bin[1] & n0) |
                       (bin[3] & bin[2] & n1 & n0) |
                       (bin[3] & bin[2] & bin[1] & n0) |
                       (bin[3] & bin[2] & bin[1] & bin[0]) );

    // Segmento D (apagado para 1, 4, 7, b, d)
    assign seg[3] = ~( (n3 & n2 & n1 & bin[0]) |
                       (n3 & bin[2] & n1 & n0) |
                       (bin[3] & bin[2] & bin[1] & bin[0]) |
                       (bin[3] & n2 & bin[1] & bin[0]) |
                       (bin[3] & bin[2] & n1 & bin[0]) );

    // Segmento E (apagado para 1, 3, 4, 5, 7, 9, b, d, F)
    assign seg[2] = ~( (n3 & n2 & n1 & bin[0]) |
                       (n3 & n2 & bin[1] & bin[0]) |
                       (n3 & bin[2] & n1 & n0) |
                       (n3 & bin[2] & bin[1] & n0) |
                       (bin[3] & bin[2] & bin[1] & bin[0]) |
                       (n3 & bin[2] & bin[1] & bin[0]) |
                       (bin[3] & n2 & bin[1] & bin[0]) |
                       (bin[3] & bin[2] & n1 & bin[0]) |
                       (bin[3] & bin[2] & bin[1] & bin[0]) );

    // Segmento F (apagado para 1, 2, 3, 7, b, d, F)
    assign seg[1] = ~( (n3 & n2 & n1 & bin[0]) |
                       (n3 & n2 & bin[1] & n0) |
                       (n3 & n2 & bin[1] & bin[0]) |
                       (bin[3] & bin[2] & bin[1] & bin[0]) |
                       (bin[3] & n2 & bin[1] & bin[0]) |
                       (bin[3] & bin[2] & n1 & bin[0]) |
                       (bin[3] & bin[2] & bin[1] & bin[0]) );

    // Segmento G (apagado para 0, 1, 7, C)
    assign seg[0] = ~( (n3 & n2 & n1 & n0) |
                       (n3 & n2 & n1 & bin[0]) |
                       (bin[3] & bin[2] & bin[1] & bin[0]) |
                       (bin[3] & bin[2] & n1 & n0) );

endmodule